' =====================================================
' Titre: Flux d'Envoi d'un Message - Diagramme de Séquence
' Description: Représente les interactions lors de l'envoi d'un message
' Acteurs: ChatViewController, SessionFacade, ChatManager, MessageDAO, Database
' =====================================================

@startuml Sequence Diagram - Send Message
!theme plain
skinparam backgroundColor #f5f5f5
skinparam sequenceActorBackgroundColor #667eea
skinparam sequenceParticipantBackgroundColor #667eea
skinparam sequenceParticipantBorderColor #764ba2
skinparam sequenceActorBorderColor #764ba2
skinparam sequenceArrowColor #764ba2
skinparam sequenceGroupBorderColor #764ba2

actor User
participant "ChatViewController" as View
participant "SessionFacade" as Facade
participant "ChatManager" as Manager
participant "MessageDAO" as DAO
database "Database" as DB

User -> View: Envoyer un message
View -> View: Valider le contenu
View -> Facade: sendMessage(userId, chatId, content)
Facade -> Manager: sendMessage(userId, chatId, content)
Manager -> Manager: Créer Message object
Manager -> DAO: createMessage(message)
DAO -> DB: INSERT INTO messages
DB --> DAO: messageId
DAO --> Manager: Message (avec ID)
Manager --> Facade: Message
Facade --> View: Message
View -> View: Ajouter le message à la ListView
View -> View: Effacer le TextArea
View -> View: Scroller vers le bas

@enduml
