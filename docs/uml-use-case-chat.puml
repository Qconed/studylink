' =====================================================
' Titre: Diagramme des Cas d'Utilisation - Système de Chat StudyLink
' Description: Représente tous les cas d'utilisation du système de chat
' Acteurs: Utilisateurs du système
' =====================================================

@startuml Use Case Diagram - Chat System
!theme plain
skinparam backgroundColor #f5f5f5
skinparam classBackgroundColor #667eea
skinparam classBorderColor #764ba2
skinparam actor {
    BackgroundColor #667eea
    BorderColor #764ba2
}

left to right direction

actor User
rectangle "Chat System" {
    usecase "Envoyer un message" as SendMessage
    usecase "Voir les messages" as ViewMessages
    usecase "Créer un chat privé" as CreatePrivateChat
    usecase "Créer un chat groupe" as CreateGroupChat
    usecase "Ajouter un membre" as AddMember
    usecase "Supprimer un membre" as RemoveMember
    usecase "Éditer un message" as EditMessage
    usecase "Supprimer un message" as DeleteMessage
    usecase "Bloquer un utilisateur" as BlockUser
    usecase "Débloquer un utilisateur" as UnblockUser
    usecase "Rechercher des messages" as SearchMessages
    usecase "Voir les participants" as ViewParticipants
}

User --> SendMessage
User --> ViewMessages
User --> CreatePrivateChat
User --> CreateGroupChat
User --> EditMessage
User --> DeleteMessage
User --> BlockUser
User --> UnblockUser
User --> SearchMessages
User --> ViewParticipants
User --> AddMember
User --> RemoveMember

CreateGroupChat --> AddMember : inclure
CreateGroupChat --> RemoveMember : inclure
ViewParticipants --> ViewMessages : associé

@enduml
