<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="dev.studylink.studylink.ui.StudySessionController" spacing="10" alignment="TOP_CENTER">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Study Sessions" styleClass="header" />
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Create New Session" onAction="#handleCreateSession" styleClass="primary-button"/>
    </HBox>

    <HBox spacing="10" VBox.vgrow="ALWAYS">
        <VBox fx:id="createdSessions" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Created Sessions" styleClass="sub-header" />
            <ListView fx:id="createdSessionsList" VBox.vgrow="ALWAYS"/>
        </VBox>

        <VBox fx:id="registeredSessions" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Registered Sessions" styleClass="sub-header" />
            <ListView fx:id="registeredSessionsList" VBox.vgrow="ALWAYS"/>
        </VBox>

        <VBox fx:id="recommendedSessions" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Recommended Sessions" styleClass="sub-header" />
            <ComboBox fx:id="categorySelector" promptText="Select Category" />
            <ListView fx:id="recommendedSessionsList" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>
</VBox>
