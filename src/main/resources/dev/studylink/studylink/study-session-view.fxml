<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns:fx="http://javafx.com/fxml" fx:controller="dev.studylink.studylink.ui.StudySessionController" fitToWidth="true" style="-fx-background-color: transparent;">
<VBox spacing="10" alignment="TOP_CENTER">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- Header with Create Button -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Study Sessions" styleClass="header" />
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Create New Session" onAction="#handleCreateSession" styleClass="primary-button"/>
    </HBox>

    <!-- Week Calendar View -->
    <VBox spacing="5">
        <Label text="This Week's Sessions" styleClass="sub-header" />
        <GridPane fx:id="weekCalendar" hgap="5" vgap="5" prefHeight="200" minHeight="200" maxHeight="200" style="-fx-border-color: #cccccc; -fx-border-width: 1; -fx-padding: 10;">
            <!-- Calendar will be populated dynamically -->
        </GridPane>
    </VBox>

    <Separator/>

    <!-- Accordion for Collapsible Sections -->
    <Accordion>
        <panes>
            <!-- Created Sessions (Collapsible) -->
            <TitledPane fx:id="createdSessionsPane" text="My Created Sessions" animated="true">
                <ListView fx:id="createdSessionsList" prefHeight="300"/>
            </TitledPane>

            <!-- Registered Sessions (Collapsible) -->
            <TitledPane fx:id="registeredSessionsPane" text="Sessions I'm Registered In" animated="true">
                <ListView fx:id="registeredSessionsList" prefHeight="300"/>
            </TitledPane>
        </panes>
    </Accordion>

    <Separator/>

    <!-- Recommended Sessions (Always Visible) -->
    <VBox spacing="5" VBox.vgrow="ALWAYS">
        <Label text="Browse All Sessions" styleClass="sub-header" />
        <ComboBox fx:id="categorySelector" promptText="Select Category" onAction="#onCategoryChange" maxWidth="Infinity"/>
        <ListView fx:id="recommendedSessionsList" VBox.vgrow="ALWAYS" prefHeight="400"/>
    </VBox>
</VBox>
</ScrollPane>
