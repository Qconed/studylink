<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="700.0" minWidth="1000.0"
            prefHeight="800.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.studylink.studylink.ui.MainAppController">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="280.0" style="-fx-background-color: #1A1640;" spacing="0">
            <!-- Logo/Header -->
            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 30 20 30 20; -fx-border-color: #2D2654; -fx-border-width: 0 0 1 0;">
                <Label text="StudyLink" textFill="#FFFFFF">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
                <Label fx:id="userNameLabel" text="User Name" textFill="#D3D2D7">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Label fx:id="userRoleLabel" text="STUDENT" textFill="#888888">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
            </VBox>

            <!-- Menu Items -->
            <VBox fx:id="sidebarMenu" spacing="5" style="-fx-padding: 20;">
                <Button fx:id="profileButton" onAction="#onProfileClick"
                        prefHeight="50.0" prefWidth="240.0" alignment="CENTER_LEFT"
                        styleClass="menu-button" text="👤  Mon Profil">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                </Button>

                <Button fx:id="friendsButton" onAction="#onFriendsClick"
                        prefHeight="50.0" prefWidth="240.0" alignment="CENTER_LEFT"
                        styleClass="menu-button" text="👥  Mes Amis">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                </Button>

                <!-- Admin only buttons -->
                <Separator style="-fx-background-color: #2D2654;" />

                <Button fx:id="usersButton" onAction="#onUsersClick"
                        prefHeight="50.0" prefWidth="240.0" alignment="CENTER_LEFT"
                        styleClass="menu-button" text="⚙️  Gestion Utilisateurs" visible="false">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                </Button>

                <Button fx:id="studySessionButton" onAction="#onStudySessionClick"
                        prefHeight="50.0" prefWidth="240.0" alignment="CENTER_LEFT"
                        styleClass="menu-button" text="📚  Study Sessions">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                </Button>


                <Region VBox.vgrow="ALWAYS" />

                <Separator style="-fx-background-color: #2D2654;" />

                <Button fx:id="logoutButton" onAction="#onLogoutClick"
                        prefHeight="50.0" prefWidth="240.0" alignment="CENTER_LEFT"
                        styleClass="menu-button-logout" text="🚪  Déconnexion">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                </Button>
            </VBox>
        </VBox>
    </left>

    <!-- CONTENT AREA -->
    <center>
        <BorderPane fx:id="contentArea" style="-fx-background-color: #F5F5F5;">
            <!-- Content will be loaded here dynamically -->
        </BorderPane>
    </center>
</BorderPane>