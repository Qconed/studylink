<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="600.0" minWidth="1000.0" prefHeight="800.0" prefWidth="1200.0" 
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="dev.studylink.studylink.ui.MainAppController">

    <left>
        <VBox maxWidth="280.0" minWidth="260.0" prefWidth="260.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 1 0 0;">
            <children>
                
                <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20 20 15 20;">
                    <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../../../images/Design_sans_titre-removebg-preview.png" />
                        </image>
                    </ImageView>
                    <Label text="StudyLink" textFill="#356ee9" style="-fx-font-weight: bold; -fx-font-size: 20;" />
                    <Label fx:id="userNameLabel" text="User Name" textFill="#1E293B" style="-fx-font-weight: bold; -fx-font-size: 13;" />
                    <Label fx:id="userRoleLabel" text="STUDENT" textFill="#94A3B8" style="-fx-font-size: 11;" />
                </VBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" 
                            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                    <content>
                        <VBox spacing="0" style="-fx-background-color: transparent;">
                            <VBox fx:id="sidebarMenu" spacing="5" style="-fx-padding: 0 15 10 15;">
                                <Button fx:id="homeButton" 
                                    onAction="#onHomeClick"
                                    alignment="CENTER_LEFT" 
                                    prefHeight="40.0" 
                                    prefWidth="230.0" 
                                    styleClass="menu-button"
                                    text="🏠   Home" />

                                <Button fx:id="friendsButton" alignment="CENTER_LEFT" onAction="#onFriendsClick" prefHeight="40.0" prefWidth="230.0" 
                                        styleClass="menu-button"
                                        text="👥 Mes ami.e.s" />
                                
                                <Button fx:id="chatButton" alignment="CENTER_LEFT" onAction="#onChatClick" prefHeight="40.0" prefWidth="230.0" 
                                        styleClass="menu-button"
                                        text="💬   Chat" />
                                                       
                                <Button fx:id="studySessionButton" onAction="#onStudySessionClick" alignment="CENTER_LEFT"  prefHeight="40.0" prefWidth="230.0" 
                                        styleClass="menu-button"
                                        text="📚  Study Sessions">
                                    <font>
                                        <Font name="System Bold" size="15.0" />
                                    </font>
                                </Button>

                                <Button fx:id="resourcesButton" alignment="CENTER_LEFT" onAction="#onResourcesClick" prefHeight="40.0" prefWidth="230.0" 
                                        styleClass="menu-button"
                                        text="📚   Resources" />
                                
                                <Button fx:id="tutoringButton" alignment="CENTER_LEFT" onAction="#onTutoringClick" prefHeight="40.0" prefWidth="230.0" 
                                        styleClass="menu-button"
                                        text="👨‍🏫   Tutoring" />
                                
                                <Button fx:id="cartButton" alignment="CENTER_LEFT" onAction="#onCartClick" prefHeight="40.0" prefWidth="230.0" 
                                        styleClass="menu-button"
                                        text="🛒   Mon Panier" />

                                <Button fx:id="notificationsButton" alignment="CENTER_LEFT" onAction="#onNotificationsClick" prefHeight="40.0" prefWidth="230.0" 
                                        styleClass="menu-button"
                                        text="🔔   Notifications">
                                    <graphic>
                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="notificationBadge" 
                                                   style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 2 6; -fx-font-size: 10; -fx-font-weight: bold;" 
                                                   text="0" 
                                                   visible="false"/>
                                        </HBox>
                                    </graphic>
                                </Button>

                                <Button fx:id="usersButton" alignment="CENTER_LEFT" onAction="#onUsersClick" prefHeight="40.0" prefWidth="230.0" 
                                        styleClass="menu-button"
                                        text="⚙️   Gestion Utilisateurs" visible="false" managed="false" />

                                <Button fx:id="categoriesButton" alignment="CENTER_LEFT" onAction="#onCategoriesClick" prefHeight="40.0" prefWidth="230.0" 
                                        styleClass="menu-button"
                                        text="📂   Gestion Catégories" visible="false" managed="false" />
                            </VBox>

                            <Region minHeight="20.0" VBox.vgrow="ALWAYS" />

                            <VBox spacing="2" style="-fx-padding: 10 15 15 15; -fx-border-color: #F1F5F9; -fx-border-width: 1 0 0 0;">
                                <Button fx:id="profileButton" alignment="CENTER_LEFT" onAction="#onProfileClick" prefHeight="40.0" prefWidth="230.0" 
                                        styleClass="menu-button"
                                        text="👤   Profile" />
                                
                                <Button fx:id="logoutButton" alignment="CENTER_LEFT" onAction="#onLogoutClick" prefHeight="40.0" prefWidth="230.0"
                                        styleClass="menu-button-logout"
                                        text="🚪   Logout" />
                            </VBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </left>

    <center>
        <BorderPane fx:id="contentArea" style="-fx-background-color: #F8FAFF;" />
    </center>
</BorderPane>