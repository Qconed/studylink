<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #100D28;"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.studylink.studylink.ui.FriendRequestController">
    <children>
        <ScrollPane fitToWidth="true" layoutX="0.0" layoutY="0.0" prefHeight="700.0" prefWidth="1000.0"
                    style="-fx-background-color: #100D28; -fx-background: #100D28;">
            <content>
                <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #100D28;">
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
                    </padding>

                    <!-- Title -->
                    <Label text="Gestion des Amis" textFill="#D3D2D7">
                        <font>
                            <Font name="System Bold" size="28.0" />
                        </font>
                    </Label>

                    <!-- Search Section -->
                    <VBox spacing="10.0" style="-fx-background-color: #1A1640; -fx-background-radius: 10; -fx-padding: 20;">
                        <Label text="Rechercher des utilisateurs" textFill="#D3D2D7">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>

                        <HBox spacing="10.0">
                            <TextField fx:id="searchField" prefHeight="40.0" prefWidth="700.0"
                                       promptText="Nom ou email..."
                                       style="-fx-background-color: #100D28; -fx-border-color: #4618F4; -fx-text-fill: white; -fx-prompt-text-fill: #888888;" />
                            <Button onAction="#onSearchUserClick" prefHeight="40.0" prefWidth="120.0"
                                    style="-fx-background-color: #4618F4; -fx-background-radius: 10;"
                                    text="Rechercher" textFill="#D3D2D7">
                                <font>
                                    <Font name="Candara Bold" size="14.0" />
                                </font>
                            </Button>
                        </HBox>

                        <ListView fx:id="searchResultsListView" prefHeight="150.0"
                                  style="-fx-background-color: #100D28; -fx-border-color: #4618F4;" />
                    </VBox>

                    <!-- Friend Requests Section -->
                    <VBox spacing="10.0" style="-fx-background-color: #1A1640; -fx-background-radius: 10; -fx-padding: 20;">
                        <Label text="Demandes d'amis reçues" textFill="#D3D2D7">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>

                        <ListView fx:id="friendRequestsListView" prefHeight="150.0"
                                  style="-fx-background-color: #100D28; -fx-border-color: #4618F4;" />
                    </VBox>

                    <!-- Friends List Section -->
                    <VBox spacing="10.0" style="-fx-background-color: #1A1640; -fx-background-radius: 10; -fx-padding: 20;">
                        <Label text="Mes amis" textFill="#D3D2D7">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>

                        <ListView fx:id="friendsListView" prefHeight="200.0"
                                  style="-fx-background-color: #100D28; -fx-border-color: #4618F4;" />
                    </VBox>

                    <!-- Back Button -->
                    <Button onAction="#onBackClick" prefHeight="40.0" prefWidth="200.0"
                            style="-fx-background-color: #888888; -fx-background-radius: 10;"
                            text="Retour" textFill="#D3D2D7">
                        <font>
                            <Font name="Candara Bold" size="16.0" />
                        </font>
                    </Button>

                    <!-- Messages -->
                    <Label fx:id="errorLabel" textFill="#FF4444" visible="false" />
                    <Label fx:id="successLabel" textFill="#4CAF50" visible="false" />
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>