<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" styleClass="content-scroll-pane"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.studylink.studylink.ui.AdminPanelController">
    <VBox spacing="30" style="-fx-background-color: #F5F5F5; -fx-padding: 40;">

        <!-- Page Title -->
        <Label text="Gestion des Utilisateurs" styleClass="page-title">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <!-- Users List Card -->
        <VBox spacing="20" styleClass="content-card">
            <Label text="Liste des Utilisateurs" styleClass="section-title" />
            <ListView fx:id="usersListView" prefHeight="300.0"
                      styleClass="content-list-view" />
        </VBox>

        <!-- User Management Card -->
        <VBox spacing="20" styleClass="content-card">
            <Label text="Gestion de l'Utilisateur Sélectionné" styleClass="section-title" />

            <!-- Role Management Section -->
            <VBox spacing="15">
                <Label text="Modifier le Rôle" style="-fx-font-weight: bold; -fx-text-fill: #333333;" />
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <ComboBox fx:id="roleComboBox" prefWidth="300.0"
                              styleClass="content-combo-box" promptText="Sélectionner un rôle" />
                    <Button onAction="#onChangeRoleClick" text="Appliquer"
                            styleClass="primary-button" prefHeight="40.0" prefWidth="120.0" />
                </HBox>
            </VBox>

            <Separator />

            <!-- Suspension Management Section -->
            <VBox spacing="15">
                <Label text="Gestion de la Suspension" style="-fx-font-weight: bold; -fx-text-fill: #333333;" />
                
                <VBox spacing="10">
                    <Label text="Raison de Suspension" styleClass="content-label" />
                    <TextArea fx:id="suspensionReasonArea" promptText="Entrez la raison de la suspension..."
                              styleClass="content-textarea" prefHeight="100.0" wrapText="true" />
                </VBox>

                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Button onAction="#onSuspendUserClick" text="Suspendre l'Utilisateur"
                            style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-font-weight: bold;"
                            prefHeight="40.0" prefWidth="200.0">
                        <font>
                            <Font size="13.0" />
                        </font>
                    </Button>
                    <Button onAction="#onUnsuspendUserClick" text="Réactiver l'Utilisateur"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"
                            prefHeight="40.0" prefWidth="200.0">
                        <font>
                            <Font size="13.0" />
                        </font>
                    </Button>
                </HBox>
            </VBox>

            <Separator />

            <!-- Delete User Section -->
            <VBox spacing="15">
                <Label text="Suppression de l'Utilisateur" style="-fx-font-weight: bold; -fx-text-fill: #333333;" />
                <Button onAction="#onDeleteUserClick" text="Supprimer l'Utilisateur Définitivement"
                        style="-fx-background-color: #FF6B35; -fx-text-fill: white; -fx-font-weight: bold;"
                        prefHeight="40.0" prefWidth="500.0">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Button>
            </VBox>
        </VBox>

        <!-- Messages -->
        <VBox spacing="10" alignment="CENTER">
            <Label fx:id="errorLabel" textFill="#F44336" visible="false" wrapText="true"
                   style="-fx-font-size: 13px; -fx-font-weight: bold;" />
            <Label fx:id="successLabel" textFill="#4CAF50" visible="false" wrapText="true"
                   style="-fx-font-size: 13px; -fx-font-weight: bold;" />
        </VBox>
    </VBox>
</ScrollPane>
