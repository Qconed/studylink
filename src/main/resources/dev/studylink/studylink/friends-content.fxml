<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="content-scroll-pane"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.studylink.studylink.ui.FriendRequestController">
    <VBox spacing="30" style="-fx-background-color: #F5F5F5; -fx-padding: 40;">

        <!-- Page Title -->
        <Label text="Mes Amis" styleClass="page-title" />

        <!-- Search Card -->
        <VBox spacing="20" styleClass="content-card">
            <Label text="Rechercher des Utilisateurs" styleClass="section-title" />

            <HBox spacing="15">
                <TextField fx:id="searchField" promptText="Nom ou email..."
                           styleClass="content-field" prefHeight="45.0" HBox.hgrow="ALWAYS" />
                <Button onAction="#onSearchUserClick" text="Rechercher"
                        styleClass="primary-button" prefHeight="45.0" prefWidth="150.0" />
            </HBox>

            <ListView fx:id="searchResultsListView" prefHeight="200.0"
                      styleClass="content-list-view" />
        </VBox>

        <!-- Friend Requests Card -->
        <VBox spacing="20" styleClass="content-card">
            <Label text="Demandes d'Amis Reçues" styleClass="section-title" />
            <ListView fx:id="friendRequestsListView" prefHeight="200.0"
                      styleClass="content-list-view" />
        </VBox>

        <!-- Friends List Card -->
        <VBox spacing="20" styleClass="content-card">
            <Label text="Ma Liste d'Amis" styleClass="section-title" />
            <ListView fx:id="friendsListView" prefHeight="300.0"
                      styleClass="content-list-view" />
        </VBox>

        <!-- Messages -->
        <VBox spacing="10" alignment="CENTER">
            <Label fx:id="errorLabel" textFill="#F44336" visible="false" wrapText="true"
                   style="-fx-font-size: 14px; -fx-font-weight: bold;" />
            <Label fx:id="successLabel" textFill="#4CAF50" visible="false" wrapText="true"
                   style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        </VBox>
    </VBox>
</ScrollPane>