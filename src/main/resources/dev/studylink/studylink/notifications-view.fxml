<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dev.studylink.studylink.ui.NotificationsController"
      spacing="20" style="-fx-background-color: #F8FAFC;">
    
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="🔔 Notifications" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="markAllReadButton" text="Tout marquer comme lu" 
                onAction="#onMarkAllAsRead"
                styleClass="secondary-button"
                style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569; -fx-padding: 8 16; -fx-background-radius: 8;"/>
        <Label fx:id="unreadCountLabel" text="0 non lues" 
               style="-fx-font-size: 14px; -fx-text-fill: #64748B; -fx-padding: 8 16; -fx-background-color: #E0E7FF; -fx-background-radius: 15;"/>
    </HBox>

    <!-- Filters -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="allFilterButton" text="Toutes" 
                onAction="#onShowAll"
                styleClass="filter-button"
                style="-fx-background-color: #356ee9; -fx-text-fill: white; -fx-padding: 8 16; -fx-background-radius: 8;"/>
        <Button fx:id="unreadFilterButton" text="Non lues" 
                onAction="#onShowUnread"
                styleClass="filter-button"
                style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569; -fx-padding: 8 16; -fx-background-radius: 8;"/>
    </HBox>

    <!-- Notifications List -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <content>
            <VBox fx:id="notificationsContainer" spacing="10" style="-fx-background-color: transparent;">
                <!-- Les notifications seront ajoutées dynamiquement ici -->
            </VBox>
        </content>
    </ScrollPane>

    <!-- Message si aucune notification -->
    <VBox fx:id="emptyStateContainer" alignment="CENTER" spacing="15" 
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 40;"
          managed="false" visible="false">
        <Label text="📭" style="-fx-font-size: 48px;"/>
        <Label text="Aucune notification" 
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #64748B;"/>
        <Label text="Vous n'avez aucune notification pour le moment" 
               style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;"/>
    </VBox>

</VBox>
