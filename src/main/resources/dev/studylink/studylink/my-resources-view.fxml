<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" styleClass="content-scroll-pane"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.studylink.studylink.ui.MyResourcesController">
    <VBox spacing="30" style="-fx-background-color: #F5F5F5; -fx-padding: 40;">

        <!-- Page Title -->
        <Label text="My Resources" styleClass="page-title">
            <font>
                <Font name="System Bold" size="32.0" />
            </font>
        </Label>

        <!-- My Created Resources Card -->
        <VBox spacing="20" styleClass="content-card">
            <Label text="Resources I Created" styleClass="section-title" />
            <ListView fx:id="myResourcesListView" prefHeight="600.0"
                      styleClass="content-list-view" />
        </VBox>

        <!-- Saved Resources Card -->
        <VBox spacing="20" styleClass="content-card">
            <Label text="Saved Resources" styleClass="section-title" />
            <ListView fx:id="savedResourcesListView" prefHeight="600.0"
                      styleClass="content-list-view" />
        </VBox>

        <!-- Messages -->
        <VBox spacing="10" alignment="CENTER">
            <Label fx:id="errorLabel" textFill="#F44336" visible="false" wrapText="true"
                   style="-fx-font-size: 14px; -fx-font-weight: bold;" />
            <Label fx:id="successLabel" textFill="#4CAF50" visible="false" wrapText="true"
                   style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        </VBox>

        <!-- Back Button -->
        <HBox alignment="CENTER">
            <Button onAction="#onBackClick" text="← Back to Home"
                    styleClass="secondary-button" prefHeight="45.0" prefWidth="180.0" />
        </HBox>
    </VBox>
</ScrollPane>
