<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dev.studylink.studylink.ui.CreateChatDialogController"
      spacing="15"
      style="-fx-font-family: 'Segoe UI', 'Helvetica Neue', Arial; -fx-font-size: 12;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Title -->
    <Label text="Créer un nouveau chat"
           style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #333;"/>

    <!-- Type selection -->
    <VBox spacing="10">
        <Label text="Type de chat" style="-fx-font-weight: bold;"/>
        <HBox spacing="20">
            <RadioButton fx:id="privateRadio" text="Chat privé" style="-fx-font-size: 12;"/>
            <RadioButton fx:id="groupRadio" text="Chat groupe" style="-fx-font-size: 12;"/>
        </HBox>
    </VBox>

    <!-- Private chat options -->
    <VBox spacing="10" fx:id="privateOptions">
        <Label fx:id="selectUserLabel" text="Sélectionner un utilisateur"
               style="-fx-font-weight: bold;"/>
        <TextField fx:id="userSearchField"
                   promptText="Rechercher par nom..."
                   prefWidth="300.0"/>
        <ComboBox fx:id="userComboBox"
                  promptText="Choisir un utilisateur..."
                  prefWidth="300.0">
        </ComboBox>
    </VBox>

    <!-- Group chat options -->
    <VBox spacing="10" fx:id="groupOptions">
        <Label fx:id="groupNameLabel" text="Nom du groupe"
               style="-fx-font-weight: bold;" visible="false"/>
        <TextField fx:id="groupNameField"
                   promptText="Entrer le nom du groupe..."
                   visible="false"/>

        <Label text="Sélectionner les participants"
               style="-fx-font-weight: bold;" visible="false"/>
        <ListView fx:id="userListView"
                  prefHeight="150.0"
                  visible="false"/>
    </VBox>

    <!-- Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="createButton" text="Créer"
                style="-fx-padding: 8 20; -fx-font-size: 12; -fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 5;"/>
        <Button fx:id="cancelButton" text="Annuler"
                style="-fx-padding: 8 20; -fx-font-size: 12; -fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 5;"/>
    </HBox>

</VBox>