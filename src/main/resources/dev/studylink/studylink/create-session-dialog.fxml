<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="dev.studylink.studylink.ui.CreateSessionDialogController" prefWidth="550">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Create New Study Session" style="-fx-padding: 0 0 15 0;"/>

    <ScrollPane fitToWidth="true" styleClass="content-scroll-pane" style="-fx-padding: 0;" VBox.vgrow="ALWAYS">
        <VBox spacing="20">
            <!-- Title -->
            <VBox spacing="8">
                <Label text="Title:*"/>
                <TextField fx:id="titleField" promptText="Enter session title" styleClass="content-field"/>
            </VBox>

            <!-- Description -->
            <VBox spacing="8">
                <Label text="Description:*"/>
                <TextArea fx:id="descriptionField" promptText="Enter session description" prefRowCount="3" styleClass="content-textarea"/>
            </VBox>

            <!-- Categories -->
            <VBox spacing="8">
                <Label text="Categories / Disciplines:*"/>
                <ListView fx:id="categoriesList" prefHeight="140" minHeight="140" styleClass="content-list-view"/>
                <Label text="Hold Ctrl/Cmd to select multiple categories"/>
            </VBox>

            <!-- Date -->
            <VBox spacing="8">
                <Label text="Date:*"/>
                <DatePicker fx:id="datePicker"/>
            </VBox>

            <!-- Time -->
            <HBox spacing="15">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Start Time:*"/>
                    <HBox spacing="8">
                        <ComboBox fx:id="startHourCombo" promptText="HH" prefWidth="70" styleClass="content-combo-box"/>
                        <Label text=":" styleClass="content-label" style="-fx-font-size: 16px;"/>
                        <ComboBox fx:id="startMinuteCombo" promptText="MM" prefWidth="70" styleClass="content-combo-box"/>
                    </HBox>
                </VBox>
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="End Time:*"/>
                    <HBox spacing="8">
                        <ComboBox fx:id="endHourCombo" promptText="HH" prefWidth="70" styleClass="content-combo-box"/>
                        <Label text=":" styleClass="content-label" style="-fx-font-size: 16px;"/>
                        <ComboBox fx:id="endMinuteCombo" promptText="MM" prefWidth="70" styleClass="content-combo-box"/>
                    </HBox>
                </VBox>
            </HBox>

            <!-- Participants -->
            <HBox spacing="15">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Min Participants:*"/>
                    <Spinner fx:id="minParticipantsSpinner" editable="true" prefWidth="100"/>
                </VBox>
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Max Participants:*"/>
                    <Spinner fx:id="maxParticipantsSpinner" editable="true" prefWidth="100"/>
                </VBox>
            </HBox>

            <!-- Location -->
            <VBox spacing="8">
                <Label text="Location:"/>
                <TextField fx:id="locationField" promptText="Enter location (optional)" styleClass="content-field"/>
            </VBox>

            <!-- Tutored Session -->
            <VBox spacing="8">
                <CheckBox fx:id="tutoredCheckBox" text="This is a tutored session"/>
            </VBox>

            <!-- Price (shown only if tutored) -->
            <VBox spacing="8" fx:id="priceBox" visible="false" managed="false">
                <Label text="Price:"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="priceField" promptText="0.00" prefWidth="120" styleClass="content-field"/>
                    <Label text="€" styleClass="content-label"/>
                    <Label text="(Leave at 0 for free session)"/>
                </HBox>
            </VBox>

            <!-- Error message -->
            <Label fx:id="errorLabel" visible="false"/>
        </VBox>
    </ScrollPane>

    <!-- Buttons -->
    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 15 0 0 0;">
        <Button text="Cancel" onAction="#handleCancel" minWidth="120" prefWidth="120" styleClass="secondary-button"/>
        <Button text="Create" onAction="#handleCreate" minWidth="120" prefWidth="120" styleClass="primary-button" defaultButton="true"/>
    </HBox>
</VBox>
