<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="dev.studylink.studylink.ui.CreateSessionDialogController" spacing="15" prefWidth="500">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Create New Study Session" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- Title -->
    <VBox spacing="5">
        <Label text="Title:*" style="-fx-font-weight: bold;"/>
        <TextField fx:id="titleField" promptText="Enter session title"/>
    </VBox>

    <!-- Description -->
    <VBox spacing="5">
        <Label text="Description:*" style="-fx-font-weight: bold;"/>
        <TextArea fx:id="descriptionField" promptText="Enter session description" prefRowCount="3"/>
    </VBox>

    <!-- Categories -->
    <VBox spacing="5">
        <Label text="Categories / Disciplines:*" style="-fx-font-weight: bold;"/>
        <ListView fx:id="categoriesList" prefHeight="100" />
        <Label text="Hold Ctrl/Cmd to select multiple categories" style="-fx-font-size: 10px; -fx-text-fill: gray;"/>
    </VBox>

    <!-- Date -->
    <VBox spacing="5">
        <Label text="Date:*" style="-fx-font-weight: bold;"/>
        <DatePicker fx:id="datePicker"/>
    </VBox>

    <!-- Time -->
    <HBox spacing="10">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Start Time:*" style="-fx-font-weight: bold;"/>
            <HBox spacing="5">
                <ComboBox fx:id="startHourCombo" promptText="HH" prefWidth="70"/>
                <Label text=":" style="-fx-font-size: 16px;"/>
                <ComboBox fx:id="startMinuteCombo" promptText="MM" prefWidth="70"/>
            </HBox>
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="End Time:*" style="-fx-font-weight: bold;"/>
            <HBox spacing="5">
                <ComboBox fx:id="endHourCombo" promptText="HH" prefWidth="70"/>
                <Label text=":" style="-fx-font-size: 16px;"/>
                <ComboBox fx:id="endMinuteCombo" promptText="MM" prefWidth="70"/>
            </HBox>
        </VBox>
    </HBox>

    <!-- Participants -->
    <HBox spacing="10">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Min Participants:*" style="-fx-font-weight: bold;"/>
            <Spinner fx:id="minParticipantsSpinner" editable="true" prefWidth="100"/>
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Max Participants:*" style="-fx-font-weight: bold;"/>
            <Spinner fx:id="maxParticipantsSpinner" editable="true" prefWidth="100"/>
        </VBox>
    </HBox>

    <!-- Location -->
    <VBox spacing="5">
        <Label text="Location:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="locationField" promptText="Enter location (optional)"/>
    </VBox>

    <!-- Tutored Session -->
    <VBox spacing="5">
        <CheckBox fx:id="tutoredCheckBox" text="This is a tutored session"/>
    </VBox>

    <!-- Price (shown only if tutored) -->
    <VBox spacing="5" fx:id="priceBox" visible="false" managed="false">
        <Label text="Price:" style="-fx-font-weight: bold;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="priceField" promptText="0.00" prefWidth="100"/>
            <Label text="€"/>
            <Label text="(Leave at 0 for free session)" style="-fx-font-size: 10px; -fx-text-fill: gray;"/>
        </HBox>
    </VBox>

    <!-- Error message -->
    <Label fx:id="errorLabel" style="-fx-text-fill: red;" visible="false"/>

    <!-- Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" prefWidth="100"/>
        <Button text="Create" onAction="#handleCreate" prefWidth="100" styleClass="primary-button" defaultButton="true"/>
    </HBox>
</VBox>
