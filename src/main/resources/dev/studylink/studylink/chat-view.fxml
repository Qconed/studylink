<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.studylink.studylink.ui.ChatViewController"
            style="-fx-font-family: 'Segoe UI', 'Helvetica Neue', Arial; -fx-font-size: 12; -fx-background-color: #f5f5f5;">

    <!-- Header du chat avec gradient -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #667eea 0%, #764ba2 100%); -fx-border-color: #5568d3; -fx-border-width: 0 0 2 0;"
              spacing="10">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="backButton" text="← Retour"
                        style="-fx-padding: 8 16; -fx-font-size: 12; -fx-font-weight: bold; -fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 6;"/>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label fx:id="chatTitleLabel" text="Chat"
                           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label fx:id="participantCountLabel" text="0 participant(s)"
                           style="-fx-font-size: 12; -fx-text-fill: rgba(255,255,255,0.8);"/>
                </VBox>
                <Button fx:id="addMemberButton" text="➕ Ajouter"
                        style="-fx-padding: 8 16; -fx-font-size: 12; -fx-font-weight: bold; -fx-background-color: rgba(255,255,255,0.25); -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.4); -fx-border-radius: 6;"/>
            </HBox>
            <Label fx:id="participantListLabel" text="Participants: "
                   style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.9); -fx-padding: 0 0 0 0;"/>
        </VBox>
    </top>

    <!-- Contenu principal avec gradient -->
    <center>
        <VBox style="-fx-background-color: linear-gradient(to bottom, #ffffff 0%, #f8f9fa 100%);">
            <!-- Liste des messages -->
            <ListView fx:id="messageListView"
                      style="-fx-control-inner-background: transparent; -fx-padding: 20; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-border-color: transparent;"
                      VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>

    <!-- Footer avec input -->
    <bottom>
        <VBox style="-fx-background-color: #ffffff; -fx-border-color: #e8e8e8; -fx-border-width: 2 0 0 0;"
              spacing="12">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>
            <HBox spacing="12" alignment="BOTTOM_RIGHT">
                <!-- TextArea pour le message avec meilleur style -->
                <TextArea fx:id="messageInputArea"
                          promptText="Écrivez votre message ici... (Max 5000 caractères)"
                          wrapText="true"
                          prefRowCount="3"
                          style="-fx-font-size: 13; -fx-font-family: 'Segoe UI', Arial; -fx-padding: 12; -fx-control-inner-background: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-text-fill: #333; -fx-focus-color: #667eea; -fx-faint-focus-color: rgba(102, 126, 234, 0.1);"
                          HBox.hgrow="ALWAYS"/>

                <!-- Bouton d'envoi stylé -->
                <Button fx:id="sendButton" text="Envoyer"
                        style="-fx-padding: 10 24; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-color: linear-gradient(to right, #667eea 0%, #764ba2 100%); -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: #5568d3; -fx-border-radius: 8; -fx-border-width: 0; -fx-effect: dropshadow(gaussian, rgba(102, 126, 234, 0.3), 5, 0, 0, 2);"
                        minWidth="90"/>
            </HBox>

            <!-- Info caractères améliorée -->
            <Label text="💡 Appuyez sur Ctrl+Enter pour envoyer rapidement"
                   style="-fx-font-size: 11; -fx-text-fill: #999; -fx-font-style: italic;"/>
        </VBox>
    </bottom>

</BorderPane>