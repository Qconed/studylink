<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" styleClass="content-scroll-pane"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.studylink.studylink.ui.ResourceFeedController">
    <VBox spacing="30" style="-fx-background-color: #F5F5F5; -fx-padding: 40;">

        <!-- Page Title -->
        <Label text="Resource Feed" styleClass="page-title">
            <font>
                <Font name="System Bold" size="32.0" />
            </font>
        </Label>

        <!-- Search and Filter Card -->
        <VBox spacing="20" styleClass="content-card">
            <Label text="Search Resources" styleClass="section-title" />

            <HBox spacing="15">
                <TextField fx:id="searchField" promptText="Search by title or content..."
                           styleClass="content-field" prefHeight="45.0" HBox.hgrow="ALWAYS" />
                <Button onAction="#onSearchClick" text="Search"
                        styleClass="primary-button" prefHeight="45.0" prefWidth="120.0" />
            </HBox>

            <HBox spacing="15">
                <ComboBox fx:id="categoryFilter" promptText="Filter by category"
                          styleClass="content-combo-box" prefWidth="300.0" prefHeight="45.0" />
                <Button onAction="#onFilterByCategoryClick" text="Filter"
                        styleClass="primary-button" prefHeight="45.0" prefWidth="120.0" />
                <Button onAction="#onRefreshClick" text="Refresh"
                        styleClass="secondary-button" prefHeight="45.0" prefWidth="120.0" />
            </HBox>

            <HBox spacing="15">
                <Button onAction="#onCreateResourceClick" text="+ Create New Resource"
                        styleClass="success-button" prefHeight="50.0" prefWidth="250.0" />
                <Button onAction="#onMyResourcesClick" text="📋 My Resources"
                        styleClass="primary-button" prefHeight="50.0" prefWidth="200.0" />
            </HBox>
        </VBox>

        <!-- Resources List Card -->
        <VBox spacing="20" styleClass="content-card">
            <Label text="All Resources" styleClass="section-title" />
            <ListView fx:id="resourcesListView" prefHeight="600.0"
                      styleClass="content-list-view" />
        </VBox>

        <!-- Messages -->
        <VBox spacing="10" alignment="CENTER">
            <Label fx:id="errorLabel" textFill="#F44336" visible="false" wrapText="true"
                   style="-fx-font-size: 14px; -fx-font-weight: bold;" />
            <Label fx:id="successLabel" textFill="#4CAF50" visible="false" wrapText="true"
                   style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        </VBox>

        <!-- Back Button -->
        <HBox alignment="CENTER">
            <Button onAction="#onBackClick" text="← Back to Home"
                    styleClass="secondary-button" prefHeight="45.0" prefWidth="180.0" />
        </HBox>
    </VBox>
</ScrollPane>
